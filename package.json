{
  "name": "new-horizon-oil-gas",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postbuild": "react-snap",
    "preview": "vite preview"
  },
  "reactSnap": {
    "source": "dist",
    "destination": "dist",
    "routes": [
      "/",
      "/about",
      "/services",
      "/transfer-services",
      "/storage-agent",
      "/injection-inspection-agent",
      "/products",
      "/products/en590-diesel",
      "/products/jet-a1",
      "/products/crude-oil",
      "/products/virgin-fuel-oil-d6",
      "/how-it-works",
      "/compliance",
      "/contact"
    ],
    "puppeteerArgs": [
      "--no-sandbox",
      "--disable-setuid-sandbox"
    ],
    "puppeteerExecutablePath": "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
  },
  "dependencies": {
    "framer-motion": "^11.3.0",
    "lucide-react": "^0.408.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.15.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.41",
    "react-snap": "^1.23.0",
    "tailwindcss": "^3.4.10",
    "vite": "^5.4.0"
  },
  "allowScripts": {
    "puppeteer@1.20.0": true
  }
}
